{
  "permissions": {
    "allow": [
      "Bash(git switch *)",
      "Bash(git merge *)",
      "Bash(git push *)",
      "Bash(git branch *)",
      "Bash(git stash *)",
      "Bash(git fetch *)",
      "Bash(git rev-list *)",
      "Bash(git ls-remote *)"
    ],
    "deny": [
      "NotebookEdit",
      "DesignSync",
      "CronCreate",
      "CronDelete",
      "CronList",
      "EnterPlanMode",
      "ExitPlanMode",
      "PushNotification",
      "RemoteTrigger",
      "ReportFindings",
      "ScheduleWakeup"
    ]
  },
  "disableClaudeAiConnectors": true,
  "disableBundledSkills": true,
  "disableWorkflows": true,
  "disableArtifact": true
}
